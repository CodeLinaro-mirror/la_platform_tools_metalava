<!--
 ! Schema for a device policy history file supplied to Metalava with the device-policy-history
 ! option (generated by frameworks/base/tools/policy-api/scripts/generate_policy_history_xml.py).
 !-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="policy-changes">
        <xs:annotation>
            <xs:documentation>
                Root element containing historical and flagged changes for device policies.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="policy" type="PolicyType" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>
                            Historical and flagged deltas for a single device policy field.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:complexType>

        <xs:key name="PolicyById">
            <xs:selector xpath="policy"/>
            <xs:field xpath="@id"/>
        </xs:key>
    </xs:element>

    <xs:complexType name="PolicyType">
        <xs:annotation>
            <xs:documentation>
                Change history for one policy, ordered from newest to oldest.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="flagged" type="FlaggedDeltaType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Unfinalized changes gated by an aconfig feature flag.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="released" type="ReleasedDeltaType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Changes introduced in a released SDK version.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    Policy field identifier matching the annotated field name.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="FlaggedDeltaType">
        <xs:annotation>
            <xs:documentation>
                Policy changes introduced behind a feature flag.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="change" type="ChangeType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="flag" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    Fully-qualified aconfig feature flag name (e.g. `package.flag_name`).
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="ReleasedDeltaType">
        <xs:annotation>
            <xs:documentation>
                Policy changes introduced in a released SDK version.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="change" type="ChangeType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="since" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    SDK version string in `major.minor` format (e.g. `36.0`).
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="ChangeType">
        <xs:annotation>
            <xs:documentation>
                A single field-level change, with the new value as element text content.
            </xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="field" type="ChangeFieldType" use="required">
                    <xs:annotation>
                        <xs:documentation>
                            Name of the policy property that changed.
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="previous" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>
                            Previous value before this change, or empty when newly added.
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:simpleType name="ChangeFieldType">
        <xs:annotation>
            <xs:documentation>
                Supported policy fields tracked in policy history.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="allowedScope">
                <xs:annotation>
                    <xs:documentation>
                        A [PolicyScope] enum constant name added to the policy.
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="allowedDpcType">
                <xs:annotation>
                    <xs:documentation>
                        An [AllowedDpcType] enum constant name added to the policy.
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="requiredCrossUserPermission">
                <xs:annotation>
                    <xs:documentation>
                        Updated cross-user permission string, with the prior value in `previous`.
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="enumValue">
                <xs:annotation>
                    <xs:documentation>
                        Integer enum value added to an enum or list-of-enum policy.
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
